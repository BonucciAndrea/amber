# Amber is a POSIX C project whose REPL loads its .k library line-by-line.
# Force LF on checkout for all source/scripts so a Windows (autocrlf) checkout
# cannot inject CR bytes that break per-line evaluation. Binary assets stay raw.
*.k    text eol=lf
*.c    text eol=lf
*.h    text eol=lf
*.sh   text eol=lf
*.q    text eol=lf
*.md   text eol=lf
*.py   text eol=lf
a      text eol=lf
build.sh text eol=lf
install.sh text eol=lf

amber  binary
*.png  binary
*.gif  binary
*.jpg  binary
