+    const char *f = qsql_find(q, " from ");
+    if (f && f > hd_end) f = NULL;               /* a `from` inside the predicate */
+    const char *proj_end = f ? f : hd_end;
+    const char *src_b = f ? f + 6 : NULL, *src_e = f ? hd_end : NULL;
