+    switch (k) {
+        case AST_QSQL_EXEC:   return "(result expression)";
+        case AST_QSQL_UPDATE: return "(column assignments)";
+        case AST_QSQL_DELETE: return "(columns to drop)";
+        default:               return "(projection list)";
+    }
