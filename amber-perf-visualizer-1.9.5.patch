+    if (_t(a) == tA && _n(a) == 1) a = _x(a);
+    if (_t(a) != tC) return NULL;
+    U n = _n(a);
+    if (n >= cap) n = (U)cap - 1;
+    memcpy(buf, (const char *)_V(a), n);
+    buf[n] = 0;
+    return buf;
+}
